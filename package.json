{
  "name": "quotelens",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local, auditable full-basket supplier comparison",
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "start": "node scripts/serve.mjs --dist",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "npm run build && playwright test",
    "check": "node --check src/app.js && node --check src/engine.js && node --check src/io.js && node --check src/explain.js && node --check src/writer.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
